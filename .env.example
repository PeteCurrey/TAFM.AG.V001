# ============================================================
# TAFM — Environment Variable Reference
# ============================================================
# Copy this file to .env.local and fill in real values.
# This file contains NO real secrets and is safe to commit.
# ============================================================

# ── Required ────────────────────────────────────────────────

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
NEXT_PUBLIC_SITE_URL="https://tafm.co.uk"
NEXT_PUBLIC_SITE_NAME="TAFM"

# ── OpenAI ──────────────────────────────────────────────────
# SECURITY: Server-side only. NEVER use NEXT_PUBLIC_ prefix.
OPENAI_API_KEY="sk-..."
OPENAI_MODEL_PRIMARY="gpt-4o"
OPENAI_MODEL_FAST="gpt-4o-mini"
OPENAI_MODEL_REASONING="o1-preview"
OPENAI_PROJECT_ID=""

# ── Analytics ───────────────────────────────────────────────
ANALYTICS_PROVIDER=""
ANALYTICS_ID=""

