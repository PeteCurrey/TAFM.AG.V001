# pnpm configuration for TAFM
# Allow build scripts for Prisma and native packages
ignore-scripts=false

# pnpm v9+ requires explicit build script approval.
# These packages need postinstall scripts to generate binaries/clients.
# Equivalent to running: pnpm approve-builds
onlyBuiltDependencies[]=@prisma/client
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=unrs-resolver
onlyBuiltDependencies[]=@img/sharp-linux-x64
onlyBuiltDependencies[]=@img/sharp-libvips-linux-x64
